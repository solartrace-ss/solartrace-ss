/*
 * ============================================================================
 * SOLARTRACE - Main Application Entry Point
 * ============================================================================
 * 
 * File      : main.cpp
 * Purpose   : Main program entry point and system initialization
 * Team      : South Sudan - UbuntuNet Alliance Women Hackathon 2026
 * ============================================================================
 */

#include <Arduino.h>
#include <WiFi.h>
#include <EEPROM.h>
#include <BlynkSimpleEsp32.h>

// Include project headers
#include "tracking.h"
#include "sensors.h"
#include "blynk_interface.h"
#include "data_logger.h"

// ============================================================================
// CONFIGURATION
// ============================================================================

// WiFi Credentials
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Blynk Authentication Token
#define BLYNK_AUTH    "YOUR_BLYNK_AUTH_TOKEN"

// System Constants
#define SYSTEM_VERSION    "1.0.0"
#define SYSTEM_NAME       "SolarTrace"
#define TEAM_NAME         "South Sudan"
#define HACKATHON_YEAR    "2026"

// ============================================================================
// GLOBAL OBJECTS
// ============================================================================

SunTracker sunTracker;
TemperatureController tempController;
BlynkInterface blynkInterface;
DataLogger dataLogger;

// ============================================================================
// SYSTEM STATE
// ============================================================================

typedef enum {
    STATE_INIT = 0,
    STATE_IDLE,
    STATE_RUNNING,
    STATE_SAFETY,
    STATE_ERROR,
    STATE_STANDBY
} SystemState;

typedef enum {
    MODE_IDLE = -1,
    MODE_COOKING = 0,
    MODE_STERILIZATION = 1,
    MODE_BOIL_WATER = 2,
    MODE_WARMING = 3,
    MODE_SAFETY = 4
} CookingMode;

SystemState systemState = STATE_INIT;
CookingMode currentMode = MODE_IDLE;
bool isSafetyActive = false;
String sessionID = "";

// ============================================================================
// FUNCTION PROTOTYPES
// ============================================================================

void setupSystem();
void setupSerial();
void setupWiFi();
void setupBlynk();
void handleSafetyCheck();
void handleModeExecution();
void updateSystemStatus();
String getModeName(CookingMode mode);
String getStateName(SystemState state);

// ============================================================================
// SETUP FUNCTION
// ============================================================================

void setup() {
    // Initialize serial communication
    setupSerial();
    
    // Print startup banner
    Serial.println("\n\n========================================");
    Serial.print("  ");
    Serial.print(SYSTEM_NAME);
    Serial.println(" - Smart Solar Cooker");
    Serial.print("  Team ");
    Serial.print(TEAM_NAME);
    Serial.print(" - Hackathon ");
    Serial.println(HACKATHON_YEAR);
    Serial.println("  Version: " + String(SYSTEM_VERSION));
    Serial.println("========================================\n");
    
    // Setup system components
    setupSystem();
    
    // Generate session ID
    sessionID = dataLogger.generateSessionID();
    Serial.println("Session ID: " + sessionID);
    
    // Initialize subsystems
    Serial.println("\nInitializing subsystems...");
    
    // Initialize tracking system
    sunTracker.begin();
    
    // Initialize temperature sensor
    tempController.begin();
    
    // Initialize SD card
    dataLogger.begin(sessionID);
    
    // Initialize Blynk
    blynkInterface.begin(BLYNK_AUTH);
    
    // Move servo to sunrise position
    sunTracker.moveToAngle(0);
    
    // Set initial state
    systemState = STATE_IDLE;
    currentMode = MODE_IDLE;
    
    // Log startup
    dataLogger.logStartup(sessionID, SYSTEM_VERSION);
    
    // Send startup notification
    blynkInterface.sendNotification("SolarTrace system ready!");
    
    Serial.println("\n" + String(SYSTEM_NAME) + " initialized successfully!");
    Serial.println("System ready. Select a cooking mode to begin.\n");
}

// ============================================================================
// LOOP FUNCTION
// ============================================================================

void loop() {
    // Run Blynk
    blynkInterface.run();
    
    // ========================================
    // 1. READ TEMPERATURE (Every 500ms)
    // ========================================
    static unsigned long lastTempRead = 0;
    if (millis() - lastTempRead >= 500) {
        lastTempRead = millis();
        float temp = tempController.readTemperature();
        blynkInterface.updateTemperature(temp);
    }
    
    // ========================================
    // 2. SAFETY CHECK (HIGHEST PRIORITY)
    // ========================================
    handleSafetyCheck();
    
    // ========================================
    // 3. SUN TRACKING (Every 10 minutes)
    // ========================================
    static unsigned long lastServoMove = 0;
    if (millis() - lastServoMove >= 600000) {  // 10 minutes
        lastServoMove = millis();
        float angle = sunTracker.calculateSunAngle();
        sunTracker.moveToAngle(angle);
    }
    
    // ========================================
    // 4. MODE EXECUTION
    // ========================================
    if (systemState == STATE_RUNNING && !isSafetyActive) {
        handleModeExecution();
    }
    
    // ========================================
    // 5. DATA LOGGING (Every 30 seconds)
    // ========================================
    static unsigned long lastLog = 0;
    if (millis() - lastLog >= 30000) {
        lastLog = millis();
        float temp = tempController.getCurrentTemperature();
        dataLogger.logData(temp, (int)currentMode);
    }
    
    // ========================================
    // 6. UPDATE DASHBOARD (Every 10 seconds)
    // ========================================
    static unsigned long lastDashboardUpdate = 0;
    if (millis() - lastDashboardUpdate >= 10000) {
        lastDashboardUpdate = millis();
        updateSystemStatus();
    }
}

// ============================================================================
// SETUP FUNCTIONS
// ============================================================================

void setupSerial() {
    Serial.begin(115200);
    delay(1000);
}

void setupSystem() {
    Serial.println("Initializing system hardware...");
    
    // Initialize I2C
    Wire.begin();
    
    // Initialize SPI
    SPI.begin();
    
    // Initialize EEPROM
    EEPROM.begin(512);
    
    Serial.println("System hardware initialized");
}

void setupWiFi() {
    Serial.println("Connecting to WiFi...");
    
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
        delay(500);
        Serial.print(".");
        attempts++;
    }
    
    if (WiFi.status() == WL_CONNECTED) {
        Serial.println("\nWiFi connected!");
        Serial.print("IP Address: ");
        Serial.println(WiFi.localIP());
    } else {
        Serial.println("\nWARNING: WiFi connection failed!");
    }
}

// ============================================================================
// CORE FUNCTIONS
// ============================================================================

void handleSafetyCheck() {
    float temp = tempController.getCurrentTemperature();
    
    // Check overheat condition
    if (temp > 130.0 && !isSafetyActive) {
        Serial.println("!!!!! OVERHEAT DETECTED !!!!!");
        Serial.print("Temperature: ");
        Serial.print(temp);
        Serial.println("°C");
        
        // Engage safety mode
        isSafetyActive = true;
        systemState = STATE_SAFETY;
        
        // Move reflector to idle
        sunTracker.moveToAngle(0);
        
        // Send emergency alert
        blynkInterface.sendEmergencyAlert(temp);
        blynkInterface.setEmergencyStop(true);
        
        // Log safety event
        dataLogger.logSafetyEvent(temp);
        
        Serial.println("SAFETY MODE ENGAGED");
        return;
    }
    
    // Disengage safety if temperature drops
    if (isSafetyActive && temp < 120.0) {
        isSafetyActive = false;
        systemState = STATE_RUNNING;
        blynkInterface.setEmergencyStop(false);
        blynkInterface.sendNotification("Safety mode disengaged - resuming operation");
        Serial.println("Safety mode disengaged");
    }
}

void handleModeExecution() {
    if (currentMode == MODE_IDLE) return;
    
    float temp = tempController.getCurrentTemperature();
    float targetTemp = 0.0;
    
    switch (currentMode) {
        case MODE_COOKING:
            targetTemp = 90.0;
            if (temp >= 100.0) {
                blynkInterface.sendNotification("Cooking temperature reached: " + String(temp) + "°C");
            }
            break;
            
        case MODE_STERILIZATION:
            targetTemp = 120.0;
            static bool sterilizing = false;
            static unsigned long startTime = 0;
            
            if (!sterilizing && temp >= 120.0) {
                sterilizing = true;
                startTime = millis();
                blynkInterface.sendNotification("Sterilization started - 20 minute hold");
                dataLogger.logEvent("Sterilization started");
            }
            
            if (sterilizing) {
                unsigned long elapsed = (millis() - startTime) / 60000;
                if (elapsed >= 20) {
                    sterilizing = false;
                    blynkInterface.sendNotification("Sterilization complete!");
                    dataLogger.logEvent("Sterilization complete");
                    currentMode = MODE_WARMING;
                }
            }
            break;
            
        case MODE_BOIL_WATER:
            targetTemp = 100.0;
            if (temp >= 100.0) {
                blynkInterface.sendNotification("Water is boiling! (100°C)");
                currentMode = MODE_WARMING;
            }
            break;
            
        case MODE_WARMING:
            targetTemp = 70.0;
            break;
            
        default:
            break;
    }
    
    // Update Blynk with target temperature
    blynkInterface.updateTargetTemperature(targetTemp);
}

void updateSystemStatus() {
    // Send status to Blynk
    String status = getModeName(currentMode);
    blynkInterface.updateStatus(status);
    
    // Print status to serial
    Serial.print("[Status] Mode: ");
    Serial.print(getModeName(currentMode));
    Serial.print(" | State: ");
    Serial.print(getStateName(systemState));
    Serial.print(" | Temp: ");
    Serial.print(tempController.getCurrentTemperature());
    Serial.println("°C");
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

String getModeName(CookingMode mode) {
    switch (mode) {
        case MODE_IDLE:          return "IDLE";
        case MODE_COOKING:       return "COOKING";
        case MODE_STERILIZATION: return "STERILIZATION";
        case MODE_BOIL_WATER:    return "BOIL_WATER";
        case MODE_WARMING:       return "WARMING";
        case MODE_SAFETY:        return "SAFETY";
        default:                 return "UNKNOWN";
    }
}

String getStateName(SystemState state) {
    switch (state) {
        case STATE_INIT:    return "INIT";
        case STATE_IDLE:    return "IDLE";
        case STATE_RUNNING: return "RUNNING";
        case STATE_SAFETY:  return "SAFETY";
        case STATE_ERROR:   return "ERROR";
        case STATE_STANDBY: return "STANDBY";
        default:            return "UNKNOWN";
    }
}
